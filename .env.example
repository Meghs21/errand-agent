# Claude (required for the agent). Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=
# Optional: model and effort (defaults: claude-opus-5-5, medium)
# ANTHROPIC_MODEL=claude-opus-5-5
# ANTHROPIC_EFFORT=medium

# PayPal sandbox app credentials from https://developer.paypal.com/dashboard/applications/sandbox
# Leave blank to run with simulated PayPal.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# Optional: real products from Channel3 (https://trychannel3.com/developers, promo PAYPAL-HACKATHON-2026).
# Leave blank to use the built-in demo catalog.
CHANNEL3_API_KEY=

# PORT=3000
