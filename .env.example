# AI: set ONE of these. Claude: https://console.anthropic.com
# Groq (has a free tier): https://console.groq.com/keys
ANTHROPIC_API_KEY=
GROQ_API_KEY=
# If both are set, Claude is used unless you add AI_PROVIDER=groq.
# Optional Groq model (default openai/gpt-oss-120b)
# GROQ_MODEL=openai/gpt-oss-120b
# Optional: model and effort (defaults: claude-opus-5-5, medium)
# ANTHROPIC_MODEL=claude-opus-5-5
# ANTHROPIC_EFFORT=medium

# PayPal sandbox app credentials from https://developer.paypal.com/dashboard/applications/sandbox
# Leave blank to run with simulated PayPal.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# Optional: real products from Channel3 (https://trychannel3.com/developers, promo PAYPAL-HACKATHON-2026).
# Leave blank to use the built-in demo catalog.
CHANNEL3_API_KEY=

# PORT=3000
